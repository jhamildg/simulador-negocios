# Copia este archivo como .env (en local) o carga estas variables en el panel de tu hosting.
# NUNCA subas el .env real ni pongas estos valores en el frontend.

# Conexión a PostgreSQL (recomendado en producción), por ejemplo la que entregan Render, Railway o Neon.
# Si se deja vacío, el servidor usa un archivo SQLite en SQLITE_PATH.
DATABASE_URL=

# Archivo SQLite cuando no hay DATABASE_URL. En un hosting debe estar en un disco persistente.
SQLITE_PATH=./data/simulador.db

# "production" activa cookies solo por HTTPS.
NODE_ENV=production

# Puerto del servidor (el hosting suele definirlo solo).
PORT=3000

# Correos que deben tener rol ADMIN, separados por coma. Se aplica al arrancar y solo a cuentas ya registradas:
# primero regístrate con ese correo y luego reinicia el servidor.
ADMIN_EMAILS=

# Días que dura una sesión iniciada.
SESSION_DAYS=30
